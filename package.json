{
  "name": "addressium",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hostable replacement for the email capabilities of Amazon Pinpoint.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "infra/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build && npm --workspace @addressium/magiclink-verify run bundle",
    "typecheck": "tsc --build --dry",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test packages/domain/dist/test/*.test.js packages/integration-tests/dist/test/*.test.js infra/cdk/dist/test/*.test.js",
    "test:web": "vitest run",
    "deploy": "npm --workspace @addressium/infra-cdk run deploy",
    "bootstrap:aws": "./scripts/aws-bootstrap.sh",
    "teardown:aws": "./scripts/aws-teardown.sh",
    "deploy:check": "./scripts/deploy-check.sh",
    "predeploy": "./scripts/deploy-check.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
